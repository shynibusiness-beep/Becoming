# ---------------------------------------------------------------------------
# Becoming — environment configuration
#
# Copy to `.env.local` and fill in. `.env.local` is git-ignored; never commit
# real credentials.
#
# Rule: NEXT_PUBLIC_* is compiled into the browser bundle and is therefore
# public. Anything secret must NOT carry that prefix.
# ---------------------------------------------------------------------------

# Deployment stage: development | staging | production
NEXT_PUBLIC_APP_STAGE=development

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable client key (`sb_publishable_...`).
# Legacy projects may still use the anon key; set NEXT_PUBLIC_SUPABASE_ANON_KEY
# instead and it will be picked up as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Analytics provider. Only `noop` is implemented; a real provider is wired up
# in M8 behind the same interface.
NEXT_PUBLIC_ANALYTICS_PROVIDER=noop

# ---------------------------------------------------------------------------
# Server only — must never be prefixed with NEXT_PUBLIC_
# ---------------------------------------------------------------------------

# Secret key (`sb_secret_...`). Bypasses Row Level Security, so it is reserved
# for explicitly server-owned operations. Unused in M0; leave empty.
SUPABASE_SECRET_KEY=
